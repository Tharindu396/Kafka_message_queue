{
  "type": "record",
  "name": "Order",
  "namespace": "com.assignment.orders.avro",
  "doc": "A purchase transaction, as defined by the assignment specification.",
  "fields": [
    { "name": "orderId", "type": "string", "doc": "Unique identifier for the order (e.g. \"1001\")" },
    { "name": "product", "type": "string", "doc": "Name of the purchased item (e.g. \"Item1\")" },
    { "name": "price",   "type": "float",  "doc": "Price of the product (randomised)" }
  ]
}
